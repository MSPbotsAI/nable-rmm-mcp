# Optional overrides — nable-rmm-mcp has no required env vars.
# All authentication is per-request via the X-Nable-Api-Token request header:
# an N-able RMM (N-sight) API key generated in Settings > General Settings >
# API. This server never stores it — it is forwarded as the `apikey` query
# parameter on every N-able RMM call.

MCP_HTTP_PORT=8080
MCP_HTTP_HOST=0.0.0.0

# N-able RMM has 11 regional servers (see README). Set the default here, or
# override per-request with the X-Nable-Server header for multi-region tenants.
# NABLE_BASE_URL=https://www.am.remote.management
